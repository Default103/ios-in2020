--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -1,1 +1,2 @@
 	uint32_t      fFlushTicks;    /* vsync ticks between panel copies */
+	uint32_t      fVsyncPeriodUS; /* software cadence; not a DSI panel mode switch */
@@ -1,4 +1,9 @@
 	uint32_t hz = 10;
 	PE_parse_boot_argn("sweetfb_hz", &hz, sizeof(hz));
+	/* Preserve <=60 Hz behavior; 120 explicitly opts into the faster timer.
+	 * The continuous-splash panel mode remains owned by the bootloader. */
+	fVsyncPeriodUS = hz == 120 ? 8333 : SWEET_FB_VSYNC_US;
+	IOLog("SWEET FB: software vsync %u Hz, period %u us; panel mode inherited\n",
+	    hz == 120 ? 120u : 60u, fVsyncPeriodUS);
 	fFlushTicks = (hz == 0 || hz >= 60) ? 1 : 60 / hz;
-	fVsync->setTimeoutUS(SWEET_FB_VSYNC_US);
+	fVsync->setTimeoutUS(fVsyncPeriodUS);
@@ -1,1 +1,1 @@
-		sender->setTimeoutUS(SWEET_FB_VSYNC_US);
+		sender->setTimeoutUS(fb->fVsyncPeriodUS);
@@ -1,1 +1,1 @@
-	sender->setTimeoutUS(SWEET_FB_VSYNC_US);
+	sender->setTimeoutUS(fb->fVsyncPeriodUS);
