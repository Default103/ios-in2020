+	values[2] = *fence;
+	values[3] = gpu_rd(kept.gpu, GPU_CP_RB_RPTR);
+	values[4] = gpu_rd(kept.gpu, GPU_CP_RB_WPTR);
+	values[5] = gpu_rd(kept.gpu, GPU_RBBM_STATUS);
+	values[6] = gpu_rd(kept.gpu, GPU_CP_HW_FAULT);
+	values[7] = gpu_rd(gmu_va, GMU_RPMH_POWER_STATE);
+	values[8] = gpu_rd(gmu_va, GMU_AO_GPU_CX_BUSY);
