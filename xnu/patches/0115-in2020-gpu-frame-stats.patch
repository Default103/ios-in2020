+/*
+ * ---- is the GPU really working while iOS draws? ----
+ *
+ * The screen updates slowly and there are four suspects: one CPU busy with
+ * the CPU copy of frames, an unfinished GPU path, a 3D core left at a low
+ * power level, and the panel copy rate itself. This tells them apart
+ * without printing per frame: one line every few seconds, and only when
+ * something moved. Nothing here changes the GPU; it reads registers that
+ * already exist plus the framebuffer's own counters, from its own thread,
+ * started once the GPU is kept on.
+ *
+ *   sweetgpustats=N  seconds between reports, 0 = off (default: 5)
+ */
+#define STAT_GMU_STATUS         (4u * 0x9306)   /* a6xx_gmu_status: halt, idle */
+#define STAT_GMU_HALT           (1u << 27)
+#define STAT_GMU_IDLE           (1u << 28)
+#define STAT_CP_ALWAYS_ON_L     (4u * 0x04fc)   /* CP_ALWAYS_ON_COUNTER, 19.2 MHz */
+#define STAT_CP_ALWAYS_ON_H     (4u * 0x04fd)
+#define STAT_CP_RB_RPTR         GPU_WORD(0x0806)
+#define STAT_CP_RB_WPTR         GPU_WORD(0x0807)
+#define STAT_RBBM_STATUS        GPU_WORD(0x0210)
+#define STAT_RBBM_INT_0         GPU_WORD(0x0201)
+#define STAT_CP_HW_FAULT        GPU_WORD(0x0821)
+#define STAT_CP_INTERRUPT       GPU_WORD(0x0823)
+
+/* iokit/Kernel/arm/SweetFramebuffer.cpp: frames arriving, frames shown. */
+extern uint64_t sweet_fb_swap_count_value(void);
+extern uint64_t sweet_fb_copy_count_value(void);
+
+static uint32_t stat_seconds;
+static int stat_sleep_chan;
+
+/* What moved since the last report: an idle screen stays silent. */
+static struct {
+	uint64_t began;
+	uint32_t fence, rptr, wptr, status, rbbm_int, hw_fault, cp_int, gmu_status, ao_l, ao_h;
+	uint64_t swaps, copies;
+} prev;
+
+static void
+stat_wait(unsigned seconds)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(seconds, NSEC_PER_SEC, &deadline);
+	(void)assert_wait_deadline(&stat_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+stat_report(void)
+{
+	uint64_t now = mach_absolute_time();
+	uint32_t fence = sweet_gpu_last();
+	uint32_t hz = 10, ticks;
+	uint32_t rptr, wptr, status, rbbm_int, hw_fault, cp_int, ao_l, ao_h, gmu_status;
+	uint64_t swaps = sweet_fb_swap_count_value(), copies = sweet_fb_copy_count_value();
+	uint64_t ns, ms, rate;
+	bool moved;
+
+	if (!kept.on) {
+		return;
+	}
+	rptr = gpu_rd(kept.gpu, STAT_CP_RB_RPTR);
+	wptr = gpu_rd(kept.gpu, STAT_CP_RB_WPTR);
+	status = gpu_rd(kept.gpu, STAT_RBBM_STATUS);
+	rbbm_int = gpu_rd(kept.gpu, STAT_RBBM_INT_0);
+	hw_fault = gpu_rd(kept.gpu, STAT_CP_HW_FAULT);
+	cp_int = gpu_rd(kept.gpu, STAT_CP_INTERRUPT);
+	ao_l = gpu_rd(kept.gpu, STAT_CP_ALWAYS_ON_L);
+	ao_h = gpu_rd(kept.gpu, STAT_CP_ALWAYS_ON_H);
+	gmu_status = gmu_va != 0 ? gpu_rd(gmu_va, STAT_GMU_STATUS) : 0;
+	/* The panel copy rate, the same rule AppleCLCD::start() uses. */
+	(void)PE_parse_boot_argn("sweetfb_hz", &hz, sizeof(hz));
+	ticks = (hz == 0 || hz >= 60) ? 1 : 60 / hz;
+
+	if (prev.began == 0) {
+		prev.began = now;
+		prev.copies = copies;
+		return;
+	}
+	absolutetime_to_nanoseconds(now - prev.began, &ns);
+	ms = ns / 1000000ull;
+	rate = ms ? (copies - prev.copies) * 1000ull / ms : 0;
+
+	moved = fence != prev.fence || rptr != prev.rptr || wptr != prev.wptr ||
+	    swaps != prev.swaps || copies != prev.copies || status != prev.status ||
+	    hw_fault != prev.hw_fault;
+
+	if (!moved) {
+		return;
+	}
+	printf("SWEET GPU STATS: +%llu ms | fence %u %s | ring rptr %u wptr %u | status %#x int %#x "
+	    "cpint %#x fault %#x | gmu %#x%s%s | ao counter %#x:%#x | requested gpu %u MHz | swaps %llu | "
+	    "panel copies %llu (%llu Hz)\n",
+	    (unsigned long long)ms, fence, sweet_gpu_done(fence) ? "done" : "running",
+	    rptr, wptr, status, rbbm_int, cp_int, hw_fault, gmu_status,
+	    (gmu_status & STAT_GMU_HALT) ? " HALTED" : "",
+	    (gmu_status & STAT_GMU_IDLE) ? " idle" : "",
+	    ao_h, ao_l, kept.khz / 1000u, (unsigned long long)swaps,
+	    (unsigned long long)copies, (unsigned long long)rate);
+	printf("SWEET GPU STATS:   the panel is copied once every %u vsync ticks "
+	    "(sweetfb_hz=N, N>=60 copies every swap); CoreAnimation sent %llu swaps\n",
+	    ticks, (unsigned long long)swaps);
+	prev.began = now;
+	prev.fence = fence;
+	prev.rptr = rptr;
+	prev.wptr = wptr;
+	prev.status = status;
+	prev.rbbm_int = rbbm_int;
+	prev.hw_fault = hw_fault;
+	prev.cp_int = cp_int;
+	prev.gmu_status = gmu_status;
+	prev.ao_l = ao_l;
+	prev.ao_h = ao_h;
+	prev.swaps = swaps;
+	prev.copies = copies;
+}
+
+static void
+stat_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+
+	printf("SWEET GPU STATS: reporting every %u s while something moves\n", stat_seconds);
+	for (;;) {
+		stat_wait(stat_seconds);
+		stat_report();
+	}
+}
+
+void
+sweet_gpu_stats_start(void)
+{
+	thread_t thread;
+
+	stat_seconds = 5;
+	(void)PE_parse_boot_argn("sweetgpustats", &stat_seconds, sizeof(stat_seconds));
+	if (stat_seconds == 0) {
+		printf("SWEET GPU STATS: off\n");
+		return;
+	}
+	if (kernel_thread_start(stat_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET GPU STATS: kernel_thread_start failed\n");
+	}
+}
+
 #endif /* ARM64_BOARD_CONFIG_SWEET */
