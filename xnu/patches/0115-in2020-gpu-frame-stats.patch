+/* sweetperf=N: opt-in, 5..60 second read-only snapshots, independent of GPU init.
+ * Framebuffer counters are individually atomic, not a transactional snapshot.
+ * present_wall_us includes preemption: it is not pure CPU execution time.
+ */
+extern void sweet_fb_perf_snapshot(uint64_t values[6]);
+extern bool sweet_gpu_perf_snapshot(uint64_t values[9]);
+static unsigned perf_seconds;
+static int perf_chan;
+
+static void
+sweet_perf_thread(void *arg, wait_result_t result)
+{
+	uint64_t prev[6] = {0}, fb[6], gpu[9], began = mach_absolute_time();
+	(void)arg;
+	(void)result;
+	sweet_fb_perf_snapshot(prev);
+	printf("SWEET PERF: interval=%u s, CPU state is EPSS estimate; GPU frequency is REQUESTED only\n", perf_seconds);
+	for (;;) {
+		uint64_t deadline, ns, now;
+		clock_interval_to_deadline(perf_seconds, NSEC_PER_SEC, &deadline);
+		(void)assert_wait_deadline(&perf_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+		now = mach_absolute_time();
+		absolutetime_to_nanoseconds(now - began, &ns);
+		uint64_t ms = ns / 1000000ull;
+		sweet_fb_perf_snapshot(fb);
+		uint64_t presents = fb[1] - prev[1];
+		uint64_t wall_ns = fb[3] - prev[3];
+		printf("SWEET PERF: dt_ms=%llu online=%u selected=%u swaps=%llu presents=%llu ticks=%llu "
+		    "present_mHz=%llu present_wall_avg_us=%llu present_wall_max_us=%llu bytes=%llu\n",
+		    (unsigned long long)ms, __atomic_load_n(&processor_avail_count, __ATOMIC_RELAXED),
+		    ml_get_topology_info()->num_cpus, (unsigned long long)(fb[0] - prev[0]),
+		    (unsigned long long)presents, (unsigned long long)(fb[2] - prev[2]),
+		    (unsigned long long)(ms ? presents * 1000000ull / ms : 0),
+		    (unsigned long long)(presents ? wall_ns / presents / 1000ull : 0),
+		    (unsigned long long)(fb[4] / 1000ull), (unsigned long long)(fb[5] - prev[5]));
+		for (unsigned d = 0; d < CPUFREQ_DOMAINS; ++d) {
+			if (!perf_domains[d]) {
+				printf("SWEET PERF CPU: domain=%u unmapped\n", d);
+				continue;
+			}
+			printf("SWEET PERF CPU: domain=%u request=%u state_raw=%#x state_mhz=%u\n", d,
+			    cpufreq_rd(perf_domains[d], CPUFREQ_PERF_STATE),
+			    cpufreq_rd(perf_domains[d], CPUFREQ_DOMAIN_STATE),
+			    (cpufreq_rd(perf_domains[d], CPUFREQ_DOMAIN_STATE) & 0xffu) * CPUFREQ_XO_KHZ / 1000u);
+		}
+		if (sweet_gpu_perf_snapshot(gpu)) {
+			printf("SWEET PERF GPU: ready=1 requested_mhz=%llu submitted=%llu completed=%llu rptr=%llu wptr=%llu "
+			    "status=%#llx fault=%#llx gmu_power=%#llx gmu_busy=%#llx\n",
+			    (unsigned long long)gpu[0], (unsigned long long)gpu[1], (unsigned long long)gpu[2],
+			    (unsigned long long)gpu[3], (unsigned long long)gpu[4], (unsigned long long)gpu[5],
+			    (unsigned long long)gpu[6], (unsigned long long)gpu[7], (unsigned long long)gpu[8]);
+		} else {
+			printf("SWEET PERF GPU: ready=0 (GPU init not complete or self-test failed)\n");
+		}
+		memcpy(prev, fb, sizeof(prev));
+		began = now;
+	}
+}
+
+static void
+sweet_perf_start(void)
+{
+	thread_t thread;
+	unsigned seconds = 0;
+	(void)PE_parse_boot_argn("sweetperf", &seconds, sizeof(seconds));
+	if (!seconds) {
+		return;
+	}
+	perf_seconds = MAX(5u, MIN(seconds, 60u));
+	if (kernel_thread_start(sweet_perf_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET PERF: failed to start observer\n");
+	}
+}
