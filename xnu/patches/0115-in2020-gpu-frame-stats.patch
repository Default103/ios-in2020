+	values[1] = __atomic_load_n(&sweet_fb_present_count, __ATOMIC_RELAXED);
+	values[2] = __atomic_load_n(&sweet_fb_tick_count, __ATOMIC_RELAXED);
+	values[3] = __atomic_load_n(&sweet_fb_present_ns, __ATOMIC_RELAXED);
+	values[4] = __atomic_load_n(&sweet_fb_present_max_ns, __ATOMIC_RELAXED);
+	values[5] = __atomic_load_n(&sweet_fb_copy_bytes, __ATOMIC_RELAXED);
