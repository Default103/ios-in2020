+int in2020_rpmh_camera_arc(bool on) {
+    for(unsigned wait=0;__atomic_exchange_n(&rh_lock,1,__ATOMIC_ACQUIRE);++wait) {
+        if(wait>=100)return EBUSY;delay_for_interval(1,NSEC_PER_MSEC);
+    }
+    int error=EIO;
+    if(!rh_poisoned && !(error=rh_map())) {
